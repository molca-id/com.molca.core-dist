    _kind: 1
    _usage: 6
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: text/muted
    _displayName: 
    _description: Secondary text. Clears 4.5:1 on the canvas in both variants, at
      a per-variant alpha.
    _kind: 1
    _usage: 6
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: text/subtle
    _displayName: 
    _description: De-emphasised text. Held to the large-text threshold (3:1) by design,
      not to 4.5:1, so it is only for large or non-essential text.
    _kind: 1
    _usage: 2
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: text/accent
