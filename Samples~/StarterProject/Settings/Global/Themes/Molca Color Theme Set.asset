    _kind: 1
    _usage: 1
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: surface/wash-subtle
    _displayName: 
    _description: "The ink colour at 20% used as a fill \u2014 a divider, hover wash
      or disabled backing. Named a surface because every measured V1 use of Text.20
      was an Image."
    _kind: 1
    _usage: 1
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: surface/wash-strong
