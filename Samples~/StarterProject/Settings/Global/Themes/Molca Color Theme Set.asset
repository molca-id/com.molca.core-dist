  - _id: surface/canvas
    _displayName: 
    _description: The window background. Translucent (alpha 0.9) as in V1, so anything
      measuring contrast against it must name an under-surface.
    _kind: 1
    _usage: 1
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: surface/panel
    _displayName: 
    _description: An opaque panel or card background.
    _kind: 1
    _usage: 1
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: surface/raised
    _displayName: 
    _description: A surface raised above the panel level.
    _kind: 1
    _usage: 1
    _required: 1
    _deprecated: 0
    _replacementId: 
    _tags: []
  - _id: surface/sunken
    _displayName: 
