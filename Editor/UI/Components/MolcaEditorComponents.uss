/*
 * Shared Molca editor component styles (Sprint 27.2).
 *
 * The reusable editor components under Editor/UI/Components/ (section card, status dot, rail item,
 * search field, mini/primary buttons, link row, compact field row) style themselves with the
 * `molca-*` classes below. Colors come exclusively from the tokens in MolcaEditorTokens.uss — no
 * copied hex — so any window that calls MolcaEditorUi.Apply() gets the design language for free,
 * not just the Hub. Layout values mirror the canonical dimensions in EDITOR_DESIGN_LANGUAGE.md.
 *
 * The Hub's own `molca-hub-*` classes (Sprint 26) predate this sheet; its section card now derives
 * from the shared MolcaSectionCard, so the Hub renders through these classes too.
 */

/* ---- Section card ---- */

/* flex-shrink: 0 is load-bearing. A card is a natural-height stack of rows, and neither the card body nor
 * a typical row carries a min-height — so in a height-bounded parent the default flex-shrink of 1 lets the
 * card be compressed, and the compression lands on the rows, which overlap their own text. A card that
 * cannot fit should overflow into its scroll view, never squeeze. */
.molca-card {
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--molca-border-soft);
    border-radius: 3px;
    background-color: var(--molca-card);
    margin-bottom: 14px;
}

.molca-card__header {
    min-height: 29px;
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--molca-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--molca-border-soft);
}

.molca-card__title-stack {
    flex-grow: 1;
}

.molca-card__title {
    color: var(--molca-heading);
    -unity-font-style: bold;
    font-size: 12px;
}

.molca-card__subtitle {
    color: var(--molca-muted);
    font-size: 10px;
    margin-top: 1px;
}

.molca-card__status-label {
    color: var(--molca-muted);
    font-size: 10px;
    margin-left: 5px;
    margin-right: 6px;
}

.molca-card__actions {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.molca-card__body {
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 12px;
    padding-right: 12px;
}

.molca-card__body--disabled {
    opacity: 0.4;
}

/*
 * The card-header help button carries no `molca-button` class of its own, so it was wearing Unity's
 * default button fill while every neighbouring action wore `--molca-control`. It needs the token fill
 * before it can carry token interaction states (declared with the other button states below): a
 * translucent hover wash over an opaque default fill *replaces* that fill rather than layering on it,
 * which reads as the button vanishing under the pointer.
 */
.molca-help-button {
    width: 20px;
    height: 20px;
    padding: 0;
    border-width: 1px;
    border-color: var(--molca-card);
    border-radius: 10px;
    background-color: var(--molca-control);
    color: var(--molca-text);
    -unity-text-align: middle-center;
    font-size: 10px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

/* ---- Status dot ---- */

.molca-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--molca-status-grey);
}

.molca-status-dot--ok {
    background-color: var(--molca-status-green);
}

.molca-status-dot--idle {
    background-color: var(--molca-status-grey);
}

.molca-status-dot--warn {
    background-color: var(--molca-status-warn);
}

.molca-status-dot--error {
    background-color: var(--molca-status-error);
}

/* ---- Compact field row ---- */

.molca-field-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 8px;
}

.molca-field-row--top {
    align-items: flex-start;
}

.molca-field-label {
    width: 118px;
    color: var(--molca-label);
    font-size: 11px;
}

.molca-field-label--slim {
    width: 96px;
}

.molca-field-control {
    flex-grow: 1;
    min-width: 0;
}

/* UIElements fields carry their own label slot; these rows supply the label, so it is collapsed. */
.molca-field-control > .unity-base-field__label {
    display: none;
}

.molca-field-textarea > .unity-base-text-field__input {
    min-height: 48px;
    white-space: normal;
}

.molca-field-list-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.molca-field-list-entry {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.molca-field-heading {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--molca-heading);
    margin-top: 8px;
    margin-bottom: 2px;
}

.molca-field-actions {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
}

/* ---- Search field (placeholder overlay) ---- */

.molca-search {
    margin-left: 9px;
    margin-right: 9px;
    margin-bottom: 8px;
}

.molca-search TextInput {
    -unity-text-align: middle-left;
    background-color: var(--molca-input);
    border-color: var(--molca-border);
    border-radius: 3px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.molca-search-placeholder {
    position: absolute;
    left: 17px;
    top: 4px;
    color: var(--molca-muted);
    font-size: 11px;
}

/* ---- Buttons ---- */

.molca-button {
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--molca-card);
    border-radius: 2px;
    background-color: var(--molca-control);
    color: var(--molca-text);
    font-size: 10px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.08s;
}

.molca-mini-button {
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
    border-radius: 2px;
}

.molca-button--primary {
    flex-grow: 0;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--molca-border);
    border-radius: 2px;
    background-color: var(--molca-primary);
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-top: 7px;
    padding-bottom: 7px;
}

/*
 * Button interaction states.
 *
 * Declared after every base and modifier rule above, and that order is load-bearing. A pseudo-class
 * counts toward specificity exactly like a class, so `.molca-button:hover` (two classes) already
 * outranks `.molca-button--primary` (one). Two consequences, both paid for once here:
 *   1. Every fill variant needs its own state pair, or the base hover repaints it — a primary action
 *      would turn control-grey under the pointer.
 *   2. A variant's pair must come after the base's, because the two tie on specificity and Unity then
 *      resolves by source order.
 * The same arithmetic is why these rules are needed at all: Unity's built-in `Button:hover` outranks a
 * single-class Molca rule, so before this block a Molca-filled button reverted to the editor's default
 * grey hover — feedback that pointed at the wrong colour rather than no feedback.
 *
 * Vocabulary: hover lifts the fill, pressed sinks it, focus rings the border for keyboard traversal,
 * disabled flattens to `--molca-control-disabled` with muted text. Pressed is `:hover:active`, not bare
 * `:active`, so dragging off a held button releases the pressed look the way Unity's own controls do.
 * Hover changes fill only, never text colour — otherwise the base rule would also recolour the white
 * label on a primary button.
 */

.molca-button:hover {
    background-color: var(--molca-control-hover);
}

.molca-button:hover:active {
    background-color: var(--molca-control-pressed);
}

.molca-button:focus {
    border-color: var(--molca-focus-ring);
}

.molca-button:disabled {
    background-color: var(--molca-control-disabled);
    color: var(--molca-muted);
}

.molca-button--primary:hover {
    background-color: var(--molca-primary-hover);
}

.molca-button--primary:hover:active {
    background-color: var(--molca-primary-pressed);
}

.molca-button--primary:disabled {
    background-color: var(--molca-control-disabled);
    color: var(--molca-muted);
}

.molca-help-button:hover {
    background-color: var(--molca-control-hover);
    color: var(--molca-heading);
}

.molca-help-button:hover:active {
    background-color: var(--molca-control-pressed);
}

.molca-help-button:focus {
    border-color: var(--molca-focus-ring);
}

/* ---- Link row ---- */

.molca-link {
    color: var(--molca-link);
}

.molca-link-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.molca-link-button {
    flex-grow: 1;
    min-width: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--molca-link);
    -unity-text-align: middle-left;
    font-size: 11px;
}

.molca-link-button:hover {
    color: var(--molca-accent);
}

/* A borderless link has no fill to sink, so pressed is carried by the text colour instead. */
.molca-link-button:hover:active {
    color: var(--molca-heading);
}

.molca-link-button:disabled {
    color: var(--molca-muted);
}

/* ---- Divider ---- */

.molca-divider {
    height: 1px;
    background-color: var(--molca-border-soft);
    margin-top: 7px;
    margin-bottom: 7px;
}

/* ---- Workbench workspace + data lists ---- */

.molca-workspace {
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
    background-color: var(--molca-bg);
}

.molca-workspace-header {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-bottom: 8px;
}

.molca-workspace-header__heading {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.molca-workspace-header__title {
    color: var(--molca-heading);
    -unity-font-style: bold;
    font-size: 15px;
    flex-shrink: 0;
}

.molca-workspace-header__summary {
    color: var(--molca-muted);
    font-size: 11px;
    margin-left: 10px;
    min-width: 0;
}

.molca-workspace-header__actions,
.molca-workspace-toolbar__actions,
.molca-list-group__actions,
.molca-list-row__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.molca-workspace-header__actions > Button,
.molca-workspace-toolbar__actions > Button,
.molca-list-group__actions > Button,
.molca-list-row__actions > Button {
    margin-left: 4px;
}

.molca-workspace-toolbar {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-bottom: 8px;
}

.molca-workspace-toolbar__content {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.molca-workspace-toolbar__content > .molca-search {
    flex-grow: 1;
    min-width: 150px;
    margin-left: 0;
    margin-right: 8px;
    margin-bottom: 0;
}

/* A TwoPaneSplitView, which lays its panes out from its own orientation — so no flex-direction here, or
 * the panes and the drag handle would end up on different axes. */
.molca-workspace-split {
    flex-grow: 1;
    min-height: 0;
}

/* Rail above the content instead of beside it, for a dock too short to show the rail beside the content:
 * the split becomes a column and the content pane takes the rest of the height. The rail itself needs no
 * special mode — it is a TreeView, so it scrolls. */
.molca-workspace-split__content {
    flex-grow: 1;
    min-width: 0;
}

/*
 * A workspace whose body starts with a navigation rail.
 *
 * The rail has to reach the panel edge. Inset by the root's padding it reads as a floating box sitting in
 * the workspace rather than as the window's own navigation, and it stops matching Settings and Docs, whose
 * roots carry no horizontal padding at all. So a railed workspace moves that padding outward: the root
 * gives it up, and the header and the content pane take it back.
 */
.molca-workspace--railed {
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.molca-workspace--railed > .molca-workspace-header,
.molca-workspace--railed > .molca-theme-preview {
    padding-left: 12px;
    padding-right: 12px;
}

.molca-workspace--railed .molca-workspace-split__content {
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
}

.molca-list {
    border-width: 1px;
    border-color: var(--molca-border);
    border-radius: 4px;
    background-color: var(--molca-card);
    overflow: hidden;
}

.molca-list-group {
    border-bottom-width: 1px;
    border-bottom-color: var(--molca-border);
}

.molca-list-group__header {
    flex-direction: row;
    align-items: center;
    min-height: 36px;
    padding-left: 7px;
    padding-right: 8px;
    background-color: var(--molca-card-header);
}

.molca-list-group__toggle,
.molca-list-row__toggle {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--molca-muted);
    -unity-text-align: middle-center;
}

.molca-list-group__toggle:hover,
.molca-list-row__toggle:hover {
    color: var(--molca-heading);
    background-color: var(--molca-control);
}

.molca-list-group__toggle:hover:active,
.molca-list-row__toggle:hover:active {
    background-color: var(--molca-control-pressed);
}

.molca-list-group__heading {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
}

.molca-list-group__title {
    color: var(--molca-heading);
    -unity-font-style: bold;
    font-size: 11px;
}

.molca-list-group__summary {
    color: var(--molca-muted);
    font-size: 10px;
    margin-left: 8px;
}

.molca-list-group__body {
    background-color: var(--molca-card);
}

.molca-list-row {
    border-top-width: 1px;
    border-top-color: var(--molca-border-soft);
    background-color: var(--molca-card);
}

.molca-list-row__line {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 7px;
    padding-right: 8px;
}

.molca-list-row__line:hover {
    background-color: rgba(198, 242, 58, 0.04);
}

.molca-list-row--selected > .molca-list-row__line,
.molca-list-row--expanded > .molca-list-row__line {
    background-color: var(--molca-row-selected);
    border-left-width: 3px;
    border-left-color: var(--molca-accent);
    padding-left: 4px;
}

.molca-list-row__leading {
    width: 26px;
    min-width: 26px;
    align-items: center;
    justify-content: center;
}

.molca-list-row__main {
    flex-grow: 1;
    min-width: 150px;
}

.molca-list-row__title {
    color: var(--molca-heading);
    -unity-font-style: bold;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.molca-list-row__subtitle {
    color: var(--molca-muted);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.molca-list-row__metadata {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    min-width: 0;
}

.molca-list-row__metadata > * {
    margin-left: 8px;
}

.molca-list-row__value {
    width: 260px;
    min-width: 120px;
    color: var(--molca-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.molca-list-row__meta {
    width: 90px;
    color: var(--molca-muted);
    font-size: 10px;
    white-space: nowrap;
}

.molca-list-row__details {
    padding-top: 9px;
    padding-bottom: 10px;
    padding-left: 40px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: var(--molca-border-soft);
    background-color: var(--molca-panel);
}

.molca-list-detail-row {
    flex-direction: row;
    align-items: flex-start;
    min-height: 22px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.molca-list-detail-row__label {
    width: 120px;
    flex-shrink: 0;
    color: var(--molca-muted);
    font-size: 10px;
}

.molca-list-detail-row__value {
    flex-grow: 1;
    min-width: 0;
    color: var(--molca-text);
    font-size: 11px;
    white-space: normal;
}

.molca-status-badge {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 20px;
    padding-left: 7px;
    padding-right: 7px;
    margin-left: 8px;
    border-radius: 10px;
    background-color: var(--molca-control);
}

.molca-status-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 5px;
    background-color: var(--molca-status-grey);
}

.molca-status-badge__label {
    color: var(--molca-text);
    font-size: 10px;
    white-space: nowrap;
}

.molca-status-badge--ok { background-color: rgba(87, 200, 74, 0.10); }
.molca-status-badge--warn { background-color: rgba(216, 178, 74, 0.12); }
.molca-status-badge--error { background-color: rgba(224, 112, 58, 0.12); }
.molca-status-badge__dot--ok { background-color: var(--molca-status-green); }
.molca-status-badge__dot--warn { background-color: var(--molca-status-warn); }
.molca-status-badge__dot--error { background-color: var(--molca-status-error); }
.molca-status-badge__dot--idle { background-color: var(--molca-status-grey); }

.molca-empty-state {
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 40px;
    padding-right: 40px;
    color: var(--molca-muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.molca-muted {
    color: var(--molca-muted);
    font-size: 11px;
    white-space: normal;
}

.molca-text--warn {
    color: var(--molca-status-warn);
    font-size: 11px;
    white-space: normal;
}

.molca-text--error {
    color: var(--molca-status-error);
    font-size: 11px;
    white-space: normal;
}

.molca-list-note {
    color: var(--molca-muted);
    font-size: 11px;
    white-space: normal;
    margin-top: 3px;
    margin-bottom: 3px;
}

.molca-list-nested {
    margin-left: 8px;
}

.molca-list-detail-heading {
    color: var(--molca-heading);
    -unity-font-style: bold;
    white-space: normal;
    margin-left: 8px;
    margin-top: 3px;
}

.molca-list-detail-text {
    color: var(--molca-text);
    white-space: normal;
    margin-left: 20px;
}

.molca-workspace-subtabs {
    flex-direction: row;
    align-items: flex-end;
    min-height: 32px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--molca-border);
}

.molca-workspace-subtab {
    min-height: 30px;
    margin: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--molca-muted);
}

.molca-workspace-subtab:hover {
    color: var(--molca-heading);
    background-color: var(--molca-control);
}

.molca-workspace-subtab--active {
    color: var(--molca-heading);
    border-bottom-color: var(--molca-accent);
    -unity-font-style: bold;
}

/* Declared after `--active` so the pressed fill applies to the current subtab too. */
.molca-workspace-subtab:hover:active {
    background-color: var(--molca-control-pressed);
}

/* ---- Themes workspace ----
 * The Themes workspace keeps a swatch vocabulary of its own (ColorThemeWorkspaceView): a colour swatch, the
 * per-variant strip that rides on a list row, the live preview strip, and the value editor rows inside an
 * expanded token. Colours that represent *theme data* are set inline from the resolved token — only the
 * chrome around them resolves from `--molca-*`. */

.molca-theme-swatch {
    flex-shrink: 0;
    margin-right: 2px;
    border-width: 1px;
    /* Deliberately not a --molca-* token. A swatch shows theme data, so its frame has to stay visible
     * against both editor skins *and* against whatever colour the token happens to be; a skin-tracking
     * border disappears exactly when the token matches the skin. Mid-grey is the one value that never does.
     * Without a frame at all, a fully transparent token is an invisible gap. */
    border-color: rgb(128, 128, 128); /* doctor:ignore — intentional fixed value, see above */
}

.molca-theme-swatch--missing {
    border-color: var(--molca-status-warn);
}

.molca-theme-strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.molca-theme-column--active {
    color: var(--molca-heading);
    -unity-font-style: bold;
}

.molca-theme-variant-picker {
    width: 130px;
    margin-right: 4px;
}

/* The preview strip is pinned below the workspace body and keeps its height: it is the feedback surface for
 * every edit above it, so a short window scrolls the body rather than crushing the preview. */
.molca-theme-preview {
    flex-shrink: 0;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--molca-border);
}

.molca-theme-preview__caption {
    color: var(--molca-muted);
    font-size: 10px;
    margin-bottom: 4px;
}

.molca-theme-preview__body {
    flex-direction: row;
    align-items: flex-start;
}

.molca-theme-preview__panel {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 6px 10px;
    border-width: 1px;
    border-radius: 3px;
    /* No background-color or border-color here: both are painted inline from the resolved tokens, and a
     * fallback would make an unresolved theme look like a resolved one. */
}

.molca-theme-preview__text {
    flex-grow: 1;
    min-width: 0;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.molca-theme-preview__chip {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 3px 8px;
    border-radius: 2px;
    font-size: 10px;
    -unity-text-align: middle-center;
}

.molca-theme-preview__legend {
    color: var(--molca-muted);
    font-size: 10px;
    margin-top: 3px;
    white-space: normal;
}

.molca-theme-preview__wall {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    flex-shrink: 0;
    width: 168px;
    margin-left: 12px;
}

.molca-theme-editor {
    align-items: center;
    min-height: 24px;
    margin-bottom: 3px;
}

.molca-theme-editor__hex {
    width: 92px;
    flex-shrink: 0;
    margin-left: 6px;
    color: var(--molca-muted);
    font-size: 10px;
    white-space: nowrap;
}

.molca-light .molca-list-row__line:hover {
    background-color: rgba(109, 154, 15, 0.08);
}

.molca-light .molca-status-badge--ok { background-color: rgba(87, 200, 74, 0.18); }
.molca-light .molca-status-badge--warn { background-color: rgba(216, 178, 74, 0.20); }
.molca-light .molca-status-badge--error { background-color: rgba(224, 112, 58, 0.20); }

/* ---- Markdown renderer (MolcaMarkdown) ----
 * Class vocabulary for the shared editor Markdown renderer (Editor/UI/MolcaMarkdown.cs). Any surface
 * that calls MolcaEditorUi.Apply() can render Markdown via MolcaMarkdown.Render(); the Assistant
 * transcript is one consumer. Colors resolve from the `--molca-*` tokens only. */

.molca-md-inline-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-bottom: 2px;
    min-width: 0;
}

.molca-md-span {
    white-space: normal;
    flex-shrink: 1;
}

.molca-md-inline-code {
    background-color: var(--molca-input);
    padding-left: 4px;
    padding-right: 4px;
    font-size: 11px;
    border-width: 1px;
    border-color: var(--molca-border);
    border-radius: 3px;
}

.molca-md-link {
    color: var(--molca-link);
    margin-right: 3px;
}

.molca-md-link:hover {
    color: var(--molca-heading);
}

.molca-md-code-block-wrap {
    position: relative;
    margin-top: 2px;
    margin-bottom: 4px;
}

.molca-md-code-block {
    background-color: var(--molca-input);
    padding: 6px 8px;
    padding-bottom: 22px;
    font-size: 11px;
    border-width: 1px;
    border-color: var(--molca-border);
    border-radius: 4px;
    margin: 0;
}

.molca-md-code-copy-btn {
    position: absolute;
    right: 4px;
    bottom: 4px;
    font-size: 9px;
    padding: 1px 6px;
    margin: 0;
    height: 16px;
    opacity: 0.6;
}

.molca-md-code-copy-btn:hover {
    opacity: 1;
}

.molca-md-list-row {
    flex-direction: row;
    margin-bottom: 3px;
    min-width: 0;
}

.molca-md-list-marker {
    width: 22px;
    flex-shrink: 0;
    -unity-text-align: upper-left;
}

.molca-md-quote {
    border-left-width: 3px;
    border-left-color: var(--molca-status-grey);
    padding-left: 8px;
    margin-bottom: 3px;
    color: var(--molca-muted);
}

/* GitHub-style alert callout (`> [!TIP]`): a quote with a titled, type-colored accent bar. The default
   rule carries the neutral (Note-less) look; the --note/--tip/… modifiers only recolor. */
.molca-md-alert {
    border-left-width: 3px;
    border-left-color: var(--molca-status-grey);
    background-color: var(--molca-panel);
    border-radius: 2px;
    padding-left: 8px;
    padding-right: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 3px;
    margin-bottom: 4px;
}

.molca-md-alert__title {
    -unity-font-style: bold;
    color: var(--molca-status-grey);
    margin-bottom: 2px;
}

.molca-md-alert--note {
    border-left-color: var(--molca-link);
}

.molca-md-alert--note .molca-md-alert__title {
    color: var(--molca-link);
}

.molca-md-alert--tip {
    border-left-color: var(--molca-status-green);
}

.molca-md-alert--tip .molca-md-alert__title {
    color: var(--molca-status-green);
}

.molca-md-alert--important {
    border-left-color: var(--molca-accent);
}

.molca-md-alert--important .molca-md-alert__title {
    color: var(--molca-accent);
}

.molca-md-alert--warning {
    border-left-color: var(--molca-status-warn);
}

.molca-md-alert--warning .molca-md-alert__title {
    color: var(--molca-status-warn);
}

.molca-md-alert--caution {
    border-left-color: var(--molca-status-error);
}

.molca-md-alert--caution .molca-md-alert__title {
    color: var(--molca-status-error);
}

.molca-md-rule {
    height: 1px;
    background-color: var(--molca-border);
    margin-top: 6px;
    margin-bottom: 6px;
}

.molca-md-task__box {
    width: 18px;
}

.molca-md-task__text--checked {
    color: var(--molca-muted);
}

.molca-md-table {
    margin-top: 3px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--molca-border);
}

.molca-md-table__row {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--molca-border);
}

.molca-md-table__row--header {
    background-color: var(--molca-input);
}

.molca-md-table__cell {
    padding: 3px 6px;
    border-right-width: 1px;
    border-right-color: var(--molca-border);
    white-space: normal;
    min-width: 0;
}

/* Whole-block text-tint variants (MolcaMarkdownVariant). */
.molca-md--muted {
    color: var(--molca-muted);
    font-size: 11px;
}

.molca-md--error {
    color: var(--molca-status-error);
}

/* Mermaid diagrams (MolcaMermaid / MolcaMermaidView). The node/edge geometry is drawn with Painter2D
 * using MolcaEditorColors; these rules frame the block and style the label text that rides on top. */
.molca-md-diagram {
    margin-top: 4px;
    margin-bottom: 6px;
    padding: 6px;
    background-color: var(--molca-input);
    border-width: 1px;
    border-color: var(--molca-border);
    border-radius: 4px;
    overflow: hidden;
    align-items: center;
}

.molca-md-diagram__canvas {
    /* width/height are set inline from the computed layout; children are absolutely positioned. */
    flex-shrink: 0;
}

.molca-md-diagram__node-label {
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 11px;
    color: var(--molca-heading);
}

.molca-md-diagram__edge-label {
    -unity-text-align: middle-center;
    white-space: nowrap;
    font-size: 10px;
    color: var(--molca-muted);
    background-color: var(--molca-input);
    padding-left: 3px;
    padding-right: 3px;
}

/* Fallback shown when a mermaid source is not a renderable flowchart (other diagram kinds, or too large). */
.molca-md-diagram-fallback {
    margin-top: 4px;
    margin-bottom: 6px;
}

.molca-md-diagram-fallback__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.molca-md-diagram-fallback__caption {
    font-size: 11px;
    color: var(--molca-muted);
}

.molca-md-diagram-fallback__copy {
    font-size: 10px;
    padding: 1px 8px;
    margin: 0;
}
