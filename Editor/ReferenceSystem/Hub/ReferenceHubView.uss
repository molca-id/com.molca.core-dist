/*
 * References workspace styles.
 *
 * Colors come exclusively from the shared tokens in MolcaEditorTokens.uss (loaded by
 * MolcaEditorUi.Apply); no copied hex. Layout follows EDITOR_DESIGN_LANGUAGE.md so the workspace
 * renders uniformly with the rest of the Hub.
 */

.molca-references {
    flex-grow: 1;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

/* ---- Health header ---- */

.molca-references__header {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
}

.molca-references__state {
    flex-grow: 1;
    flex-shrink: 1;
}

.molca-references__state-line {
    flex-direction: row;
    align-items: center;
}

.molca-references__state-label {
    -unity-font-style: bold;
    font-size: 13px;
    color: var(--molca-heading);
    margin-right: 8px;
}

.molca-references__state-counts {
    font-size: 11px;
    color: var(--molca-text);
    flex-shrink: 1;
}

.molca-references__state-detail {
    font-size: 11px;
    color: var(--molca-muted);
    white-space: normal;
}

.molca-references__stale {
    font-size: 11px;
    color: var(--molca-status-warn);
    white-space: normal;
    margin-top: 2px;
}

.molca-references__header-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.molca-references__progress {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.molca-references__progress-bar {
    flex-grow: 1;
}

/* ---- Primary view tabs ---- */

.molca-references__views {
    flex-direction: row;
    flex-wrap: wrap;
    border-bottom-width: 1px;
    border-bottom-color: var(--molca-border-soft);
    margin-bottom: 6px;
}

.molca-references__view-tab {
    height: 22px;
    padding-left: 10px;
    padding-right: 10px;
    margin-left: 0;
    margin-right: 2px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--molca-muted);
    font-size: 11px;
}

.molca-references__view-tab:hover {
    color: var(--molca-text);
}

.molca-references__view-tab--active {
    color: var(--molca-heading);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: var(--molca-accent);
}

/* ---- Filters ---- */

.molca-references__filters {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.molca-references__search {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 140px;
    margin-right: 6px;
}

/*
 * Base is the OFF look and --active the calm on look, matching the Doctor's chips: a workspace with
 * every severity shown reads uniform rather than lit up.
 */
.molca-references__chip {
    height: 20px;
    padding-left: 9px;
    padding-right: 9px;
    margin-left: 3px;
    border-width: 1px;
    border-color: var(--molca-border-soft);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--molca-muted);
    font-size: 11px;
    opacity: 0.55;
}

.molca-references__chip--active {
    color: var(--molca-text);
    border-color: var(--molca-border);
    opacity: 1;
}

/*
 * Hover, declared after `--active` so it reaches the on chips too (a pseudo-class outranks the plain
 * modifier, and the two tie, so order decides). Accent border, the same mark the Doctor's chip wall
 * uses — and *only* the border: on this strip the on/off difference is carried entirely by text colour
 * and opacity, so a hover that also brightened those would make a hovered off chip look switched on.
 * Pressed adds a wash, which works here because the resting fill is transparent.
 */
.molca-references__chip:hover {
    border-color: var(--molca-accent);
}

.molca-references__chip:hover:active {
    background-color: var(--molca-pressed-wash);
}

.molca-references__filter-summary {
    font-size: 11px;
    color: var(--molca-muted);
    margin-left: 8px;
    flex-shrink: 1;
}

.molca-references__filters--narrow .molca-references__search {
    min-width: 100px;
}

/* ---- Split: table + detail ---- */

.molca-references__split {
    flex-direction: row;
    flex-grow: 1;
}

/*
 * Under the narrow-width threshold the two panes stack instead of shrinking to unreadable widths.
 * The table keeps a bounded height so the detail panel is always reachable without scrolling past
 * the whole table.
 */
.molca-references__split--narrow {
    flex-direction: column;
}

.molca-references__table-pane {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 220px;
}

.molca-references__split--narrow .molca-references__table-pane {
    max-height: 240px;
    min-width: 0;
}

.molca-references__table {
    flex-grow: 1;
    min-height: 120px;
}

.molca-references__detail-pane {
    width: 38%;
    min-width: 240px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: var(--molca-border-soft);
    padding-left: 8px;
    margin-left: 8px;
}

.molca-references__split--narrow .molca-references__detail-pane {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    border-left-width: 0;
    border-top-width: 1px;
    border-top-color: var(--molca-border-soft);
    padding-left: 0;
    margin-left: 0;
    padding-top: 8px;
    margin-top: 8px;
}

.molca-references__detail {
    flex-grow: 1;
}

/* ---- Table cells ---- */

/*
 * Column geometry is the MultiColumnTreeView's job now: it owns the header, the widths, the resize
 * handles and the sort indicators. What used to live here was a parallel implementation of all of that —
 * a shared array of width classes applied to both a hand-built header row and every data row, purely so
 * the two could not drift apart. These rules style cell *content* only, and must not reintroduce a
 * flex-basis: a cell that sizes itself from its own text is exactly the misalignment the control fixes.
 */
.molca-references__cell {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--molca-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

/* The name column carries the severity dot, so colour and text always travel together. */
.molca-references__name-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    overflow: hidden;
}

.molca-references__row-dot {
    flex-shrink: 0;
    margin-right: 6px;
}

.molca-references__cell--name {
    color: var(--molca-text);
}

/* A group heading names a Ref Type, not a row that can be acted on, so it reads as structure. */
.molca-references__cell--group {
    -unity-font-style: bold;
    color: var(--molca-heading);
}

/*
 * Monospaced because this column holds RefType:RefId pairs and a generated id is a guid. In the
 * proportional brand face two nearly-identical ids look identical, which is precisely the comparison a
 * duplicate report asks the reader to make. RobotoMono is a Unity editor built-in
 * (Editor/Data/Resources/Fonts), so this costs the package no asset.
 */
.molca-references__cell--identity {
    -unity-font-definition: resource("Fonts/RobotoMono-Regular");
    font-size: 10px;
    color: var(--molca-muted);
}

.molca-references__empty {
    font-size: 11px;
    color: var(--molca-muted);
    white-space: normal;
    padding-top: 10px;
    padding-bottom: 6px;
}

/* ---- Detail panel content ---- */

.molca-references__note {
    font-size: 11px;
    color: var(--molca-muted);
    white-space: normal;
    margin-bottom: 4px;
}

.molca-references__field {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
}

.molca-references__field-key {
    width: 92px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--molca-muted);
}

.molca-references__field-value {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--molca-text);
    white-space: normal;
}

.molca-references__field-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--molca-heading);
    margin-top: 6px;
    margin-bottom: 2px;
}

.molca-references__candidate {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.molca-references__candidate-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--molca-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-references__actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.molca-references__coverage-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 3px;
}

.molca-references__coverage-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--molca-text);
    white-space: normal;
}

/* ---- Authoring controls ---- */

/*
 * Identity editors sit in the detail panel next to the row they change, at the panel's own width. They
 * are deliberately plain fields rather than inline-editable table cells: typing a Ref Id into a grid
 * would read as a field edit, and it is a refactor over every reference that names the old one.
 */
.molca-references__authoring-field {
    margin-top: 4px;
    margin-bottom: 2px;
}

.molca-references__graph {
    margin-top: 6px;
}

/* ---- Load set editor ---- */

.molca-references__loadsets {
    margin-top: 4px;
}

.molca-references__loadset {
    border-left-width: 2px;
    border-left-color: var(--molca-border);
    padding-left: 6px;
    margin-bottom: 8px;
}

.molca-references__loadset-group {
    margin-top: 4px;
    margin-left: 8px;
}

.molca-references__loadset-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.molca-references__loadset-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 80px;
}

/* ---- Policy ---- */

/*
 * A header-toggled panel rather than a card appended under every selected row. Policy is the same ten
 * rows whatever is selected, and rebuilding it beneath each finding pushed that finding's own detail off
 * the top of the panel.
 */
.molca-references__policy-panel {
    margin-bottom: 6px;
}

.molca-references__policy-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.molca-references__policy-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--molca-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-references__policy-field {
    width: 110px;
    flex-shrink: 0;
}

.molca-references__policy-locked {
    width: 110px;
    flex-shrink: 0;
    font-size: 11px;
    color: var(--molca-muted);
    -unity-text-align: middle-left;
}
