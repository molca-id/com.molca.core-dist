/*
 * Styling for the Molca Assistant chat window (Sprint 25.1).
 * The window's static layout lives in AssistantChatWindow.uxml; this sheet owns all cosmetic
 * styling. The role palette is exposed as USS custom properties on .chat-root so row/title/accent
 * rules and any future theming reference one source of truth instead of hardcoded C# Color literals.
 */

.chat-root {
    /* Role accent colors (left bar / header label). Re-based on the shared Molca tokens
       (MolcaEditorTokens.uss) so the Assistant wears the brand palette — the assistant accent is the
       signature Molca lime, and status/link/neutral roles inherit the same vocabulary as the Hub. */
    --user-accent: var(--molca-link);
    --assistant-accent: var(--molca-accent);
    --tool-accent: var(--molca-status-grey);
    --error-accent: var(--molca-status-error);
    --prompt-accent: var(--molca-status-warn);
    --link-color: var(--molca-link);

    /* Row backgrounds per role — translucent accent washes composited over the themed card surface,
       so they track the active skin instead of baking dark RGB. The card shows through, the role's hue
       only faintly tints it. Light-skin alphas are nudged up in the `.molca-light` block below. */
    --row-bg-user: rgba(91, 155, 213, 0.05);
    --row-bg-assistant: rgba(198, 242, 58, 0.05);
    --row-bg-tool: rgba(107, 107, 107, 0.05);
    --row-bg-error: rgba(224, 112, 58, 0.07);
    --row-bg-prompt: rgba(216, 178, 74, 0.07);

    /* Surfaces — all neutral grays/borders pulled from the Molca tokens for editor-wide consistency
       and automatic light-skin response. */
    --scroll-bg: var(--molca-panel);
    --scroll-border: var(--molca-border);
    --composer-bg: var(--molca-input);
    --composer-edge: var(--molca-border-soft);
    --chip-bg: var(--molca-row-selected);
    --chip-label: var(--molca-text);
    --code-bg: var(--molca-input);
    --muted-text: var(--molca-muted);
    --warn-text: var(--molca-status-warn);
    --accent-text: var(--molca-status-green);

    /* Primary (Send) button on the fixed lime accent. The accent hue is skin-invariant, so these are
       named once here rather than recolored per skin: dark foreground for contrast on lime, and a
       lighter lime for the hover lift. */
    --send-bg: var(--molca-accent);
    --send-fg: rgb(26, 28, 18); /* doctor:ignore — dark foreground on the fixed lime accent, legible in both skins */
    --send-hover: rgb(210, 250, 90); /* doctor:ignore — lighter lime hover on the skin-invariant accent */

    padding: 6px;
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

/*
 * Light-skin overrides. The translucent role washes need a touch more alpha to read against the
 * lighter panel surface; the surface/text tokens themselves already track the skin through the
 * shared `--molca-*` vocabulary, so only the role tints are restated here. Mirrors the pattern in
 * MolcaEditorTokens.uss (`.molca-editor.molca-light`). The `molca-light` class is applied to the
 * root by MolcaEditorUi.Apply when EditorGUIUtility.isProSkin is false. `molca-light` and `chat-root`
 * are applied to the same root element, so this is a compound selector (no descendant space).
 */
.molca-light.chat-root {
    --row-bg-user: rgba(38, 96, 158, 0.08);
    --row-bg-assistant: rgba(120, 150, 30, 0.09);
    --row-bg-tool: rgba(107, 107, 107, 0.08);
    --row-bg-error: rgba(224, 112, 58, 0.09);
    --row-bg-prompt: rgba(216, 178, 74, 0.11);
}

/* ---- Header ------------------------------------------------------------------------------- */

.chat-header {
    flex-direction: row;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.chat-status {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-left;
}

.chat-icon-button {
    width: 26px;
    height: 22px;
    padding: 0;
    margin-left: 2px;
    margin-right: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 5px;
    transition-property: background-color;
    transition-duration: 0.08s;
}

.chat-icon-button:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.chat-icon-button:active {
    background-color: rgba(255, 255, 255, 0.16);
}

/* A white overlay all but vanishes on the light panel — darken the lift instead so the hover/active
   affordance stays visible under the light skin. */
.molca-light .chat-icon-button:hover {
    background-color: rgba(0, 0, 0, 0.07);
}

.molca-light .chat-icon-button:active {
    background-color: rgba(0, 0, 0, 0.13);
}

.chat-icon-button__image {
    width: 15px;
    height: 15px;
    align-self: center;
    opacity: 0.85;
}

.chat-icon-button:hover .chat-icon-button__image {
    opacity: 1;
}

/* ---- Sticky last-question banner (Sprint 25.4) -------------------------------------------- */

.chat-banner {
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 4px 8px;
    background-color: var(--row-bg-user);
    border-left-width: 3px;
    border-left-color: var(--user-accent);
    border-radius: 3px;
    font-size: 11px;
    color: var(--chip-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ---- Live tool-call progress row (build/deploy) ------------------------------------------- */

.chat-tool-progress {
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 4px 8px;
    background-color: var(--row-bg-tool);
    border-left-width: 3px;
    border-left-color: var(--tool-accent);
    border-radius: 3px;
}

.chat-tool-progress__label {
    font-size: 11px;
    color: var(--chip-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
}

.chat-tool-progress__bar {
    height: 12px;
}

/* ---- Transcript scroll -------------------------------------------------------------------- */

.chat-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: var(--scroll-border);
    border-radius: 4px;
    background-color: var(--scroll-bg);
}

/* ---- Composer ----------------------------------------------------------------------------- */

.chat-composer {
    flex-shrink: 0;
    flex-direction: column;
    background-color: var(--composer-bg);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--composer-edge);
    padding: 7px 8px;
}

.chat-context-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
}

.chat-add-context {
    flex-shrink: 0;
    margin-right: 4px;
    margin-left: 0;
    height: 18px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
}

.chat-context-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    flex-grow: 1;
}

.chat-input {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    min-height: 32px;
    max-height: 180px;
    min-width: 0;
    margin: 0;
}

.chat-control-row {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
}

/* Queued-message slot (Sprint 91.1b): a message typed while a turn runs, auto-sent on completion. */
.chat-queued-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: var(--row-bg-user);
    border-left-width: 2px;
    border-left-color: var(--user-accent);
}

.chat-queued-row__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 10px;
    color: var(--muted-text);
    -unity-font-style: italic;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Segmented action-mode control (Sprint 91.1g). */
.chat-mode-seg {
    flex-direction: row;
    flex-shrink: 0;
}

.chat-mode-seg__btn {
    height: 18px;
    margin: 0;
    padding: 0 7px;
    font-size: 10px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--composer-edge);
    color: var(--muted-text);
}

/* Modifier classes, not :first-child/:last-child — USS supports neither (nor `:not()`, per the note in
   MolcaHubWindow.uss). The end classes are applied in AssistantComposer.BuildModeControl. */
.chat-mode-seg__btn--first {
    border-left-width: 1px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.chat-mode-seg__btn--last {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.chat-mode-seg__btn--selected {
    background-color: var(--chip-bg);
    color: var(--chip-label);
    -unity-font-style: bold;
}

.chat-mode-seg__btn--auto.chat-mode-seg__btn--selected { color: var(--user-accent); }
.chat-mode-seg__btn--plan.chat-mode-seg__btn--selected { color: var(--prompt-accent); }
.chat-mode-seg__btn--all.chat-mode-seg__btn--selected { color: var(--error-accent); }

/* Stat segments (Sprint 91.1f): tokens / cost / cache / reasoning, each tooltipped; click for detail. */
.chat-stats-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 8px;
    overflow: hidden;
}

.chat-stat {
    font-size: 10px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-text-align: middle-left;
    color: var(--muted-text);
}

.chat-token-estimate {
    font-size: 10px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-align: middle-left;
    color: var(--muted-text);
}

.chat-token-estimate--warn {
    color: var(--warn-text);
}

.chat-compaction-view {
    font-size: 10px;
    flex-shrink: 0;
    margin-left: 8px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: transparent;
    border-width: 0;
    color: var(--accent-text);
    -unity-text-align: middle-left;
}

.chat-send,
.chat-stop {
    width: 64px;
    flex-shrink: 0;
    height: 20px;
}

/* Primary action wears the Molca lime with dark text for contrast. */
.chat-send {
    background-color: var(--send-bg);
    color: var(--send-fg);
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 4px;
}

.chat-send:hover {
    background-color: var(--send-hover);
}

/* ---- Context chips ------------------------------------------------------------------------ */

.chat-chip {
    flex-direction: row;
    align-items: center;
    background-color: var(--chip-bg);
    border-radius: 9px;
    padding-left: 8px;
    padding-right: 4px;
    margin-right: 4px;
    margin-bottom: 2px;
    height: 18px;
}

.chat-chip__label {
    font-size: 10px;
    color: var(--chip-label);
}

.chat-chip__remove {
    width: 16px;
    height: 16px;
    margin-left: 2px;
    padding-left: 0;
    padding-right: 0;
}

/* Overflow "+N" chip when the pinned set collapses (Sprint 91.1h). */
.chat-chip--more {
    padding-right: 8px;
    font-size: 10px;
    color: var(--chip-label);
    border-width: 0;
    margin-top: 0;
    margin-left: 0;
}

/* ---- Suggestion popup: @ mentions and / commands (Sprint 91.1c/d) ------------------------- */

.chat-suggest {
    flex-direction: column;
    background-color: var(--composer-bg);
    border-width: 1px;
    border-color: var(--scroll-border);
    border-radius: 5px;
    padding: 3px;
    max-height: 220px;
}

.chat-suggest__row {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 3px;
    color: var(--chip-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-suggest__row--selected {
    background-color: var(--chip-bg);
}

/* ---- Chat pane + artifact canvas (Sprint 92) ------------------------------------------------ */

.chat-pane {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    padding-right: 4px;
}

.chat-canvas {
    flex-direction: column;
    min-width: 0;
    padding-left: 4px;
    border-left-width: 1px;
    border-left-color: var(--scroll-border);
}

.chat-canvas__header {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.chat-canvas__tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* A row container (not a Button — see AssistantCanvasView): label + close affordance as siblings. */
.chat-canvas__tab {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 20px;
    margin: 0 2px 2px 0;
    padding: 0 6px 0 8px;
    font-size: 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--composer-edge);
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted-text);
}

/* No color here on purpose: text colour inherits from the tab, so the --active rule tints the label too. */
.chat-canvas__tab-label {
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
}

.chat-canvas__tab--active {
    background-color: var(--chip-bg);
    color: var(--chip-label);
    -unity-font-style: bold;
}

.chat-canvas__tab-close {
    width: 14px;
    height: 14px;
    margin: 0 0 0 5px;
    padding: 0;
    font-size: 9px;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted-text);
}

.chat-canvas__tab-close:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: var(--chip-label);
}

.molca-light .chat-canvas__tab-close:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

/* The restore chip is a plain Button with no close affordance, so it keeps symmetric padding. */
.chat-canvas__tab--restore {
    -unity-font-style: italic;
    padding: 0 8px;
}

.chat-canvas__content {
    flex-grow: 1;
    min-height: 0;
    border-width: 1px;
    border-color: var(--scroll-border);
    border-radius: 4px;
    background-color: var(--scroll-bg);
    padding: 6px;
}

.chat-canvas__empty,
.chat-canvas__note {
    white-space: normal;
    font-size: 11px;
    color: var(--muted-text);
    -unity-font-style: italic;
    margin-bottom: 4px;
}

/* Inline artifact card standing in for a molca-* fenced block in the transcript (Sprint 92.3). */
.chat-artifact-card {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--composer-edge);
    background-color: var(--code-bg);
}

.chat-artifact-card__icon {
    flex-shrink: 0;
    margin-right: 6px;
    color: var(--accent-text);
}

.chat-artifact-card__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--chip-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-artifact-card__open {
    flex-shrink: 0;
    height: 18px;
    font-size: 10px;
    padding: 0 8px;
}

/* Workflow proposal panel (Sprint 94.1). */
.chat-proposal__title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* Wraps rather than clipping: the facet summary is long ("…confirms before running") and was truncated. */
.chat-proposal__facets {
    font-size: 10px;
    color: var(--muted-text);
    margin-bottom: 4px;
    white-space: normal;
}

.chat-proposal__issue {
    font-size: 11px;
    color: var(--error-accent);
    white-space: normal;
    margin-bottom: 2px;
}

.chat-proposal__issue--warn {
    color: var(--warn-text);
}

.chat-proposal__issue--ok {
    color: var(--accent-text);
}

.chat-run__diagnostic {
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
    color: var(--muted-text);
}

.chat-proposal__step {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    margin-bottom: 1px;
    border-radius: 3px;
    background-color: var(--row-bg-tool);
}

.chat-proposal__step-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.chat-proposal__step-label--unknown {
    color: var(--error-accent);
}

.chat-proposal__badge {
    flex-shrink: 0;
    font-size: 9px;
    margin-left: 4px;
    padding: 0 5px;
    border-radius: 7px;
    background-color: var(--chip-bg);
    color: var(--prompt-accent);
}

.chat-proposal__badge--irreversible {
    color: var(--error-accent);
}

.chat-proposal__critical {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 10px;
}

.chat-proposal__actions {
    flex-direction: row;
    margin-top: 6px;
}

/* Run binding panel (Sprint 94.2). */
.chat-run__status {
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.chat-run__status--succeeded { color: var(--assistant-accent); }
.chat-run__status--failed, .chat-run__status--refused { color: var(--error-accent); }
.chat-run__status--cancelled, .chat-run__status--interrupted { color: var(--muted-text); }

.chat-run__step--pass {
    font-size: 11px;
    color: var(--chip-label);
}

.chat-run__step--fail {
    font-size: 11px;
    color: var(--error-accent);
}

/* Findings panel rows (Sprint 92.5). */
.chat-findings {
    flex-direction: column;
}

.chat-findings__row {
    flex-direction: row;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-radius: 3px;
    border-left-width: 3px;
    border-left-color: var(--tool-accent);
    background-color: var(--row-bg-tool);
}

.chat-findings__row--error {
    border-left-color: var(--error-accent);
    background-color: var(--row-bg-error);
}

.chat-findings__row--warning {
    border-left-color: var(--prompt-accent);
    background-color: var(--row-bg-prompt);
}

.chat-findings__glyph {
    width: 18px;
    flex-shrink: 0;
    -unity-text-align: upper-center;
}

.chat-findings__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.chat-findings__code {
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.chat-findings__message {
    font-size: 11px;
    white-space: normal;
    color: var(--chip-label);
}

.chat-findings__fix {
    font-size: 10px;
    white-space: normal;
    margin-top: 2px;
    color: var(--muted-text);
}

/* ---- Floating "new messages" jump chip (Sprint 91.2d) -------------------------------------- */

.chat-jump-chip {
    position: absolute;
    bottom: 8px;
    right: 16px;
    height: 20px;
    padding: 0 10px;
    font-size: 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--scroll-border);
    background-color: var(--composer-bg);
    color: var(--chip-label);
}

/* ---- Transcript rows ---------------------------------------------------------------------- */

.chat-row {
    flex-direction: column;
    margin-bottom: 2px;
    padding: 8px 8px 8px 10px;
    border-left-width: 3px;
}

.chat-row--continuation {
    padding-top: 2px;
    margin-top: -2px;
}

.chat-row--user {
    border-left-color: var(--user-accent);
    background-color: var(--row-bg-user);
}

.chat-row--assistant {
    border-left-color: var(--assistant-accent);
    background-color: var(--row-bg-assistant);
}

.chat-row--tool {
    border-left-color: var(--tool-accent);
    background-color: var(--row-bg-tool);
}

.chat-row--error {
    border-left-color: var(--error-accent);
    background-color: var(--row-bg-error);
}

.chat-row--prompt {
    border-left-color: var(--prompt-accent);
    background-color: var(--row-bg-prompt);
}

.chat-row--plan {
    border-left-color: var(--prompt-accent);
}

.chat-row__title--plan { color: var(--prompt-accent); }

/* Work-row custom disclosure (replaces the Unity Foldout header so nothing paints the row pale). */
.chat-work__header {
    flex-direction: row;
    align-items: center;
}

.chat-work__arrow {
    width: 12px;
    flex-shrink: 0;
    font-size: 9px;
    color: var(--muted-text);
    -unity-text-align: middle-center;
}

.chat-work__label {
    -unity-font-style: bold;
    font-size: 11px;
    color: var(--tool-accent);
}

.chat-work__content {
    margin-top: 3px;
    padding-left: 12px;
}

/* Nested tool-chain / raw-result foldouts inside the work content are still Unity Foldouts; force
   their toggle transparent so the editor default header/focus highlight doesn't paint them pale. */
.chat-row--tool .unity-foldout,
.chat-row--tool .unity-foldout > .unity-toggle,
.chat-row--tool .unity-foldout__toggle,
.chat-row--tool .unity-foldout__toggle > .unity-toggle__input {
    background-color: rgba(0, 0, 0, 0);
    margin-left: 0;
    margin-right: 0;
}

.chat-row--tool .unity-foldout__toggle:focus,
.chat-row--tool .unity-foldout__toggle:hover,
.chat-row--tool .unity-foldout__toggle:checked {
    background-color: rgba(0, 0, 0, 0);
}

.chat-row__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.chat-row__header--continuation {
    margin-bottom: 0;
}

.chat-row__title {
    -unity-font-style: bold;
    flex-grow: 1;
    font-size: 11px;
}

.chat-row__title--user { color: var(--user-accent); }
.chat-row__title--assistant { color: var(--assistant-accent); }
.chat-row__title--tool { color: var(--tool-accent); }
.chat-row__title--error { color: var(--error-accent); }
.chat-row__title--prompt { color: var(--prompt-accent); }

/* ---- Interactive prompt controls (Sprint 25.7) ------------------------------------------- */

.chat-prompt-options {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.chat-prompt-option {
    flex-shrink: 0;
    height: 20px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
}

.chat-prompt-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.chat-prompt-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
}

.chat-prompt-answer {
    white-space: normal;
    margin-top: 4px;
    color: var(--prompt-accent);
    -unity-font-style: bold;
}

/* Answered action-confirmation outcome — a compact one-liner standing in for the full ask. */
.chat-confirm-outcome {
    white-space: normal;
    font-size: 11px;
    -unity-font-style: bold;
}

.chat-confirm-outcome--ok {
    color: var(--assistant-accent);
}

.chat-confirm-outcome--declined {
    color: var(--muted-text);
}

/* Structured plan turn (Sprint 52): an ordered, reviewable checklist with per-step status glyphs and
   inline edit controls while awaiting approval. */
.chat-plan {
    flex-direction: column;
    margin-top: 2px;
}

.chat-plan__step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.chat-plan__glyph {
    width: 16px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    color: var(--muted-text);
}

.chat-plan__glyph--running {
    color: var(--prompt-accent);
}

.chat-plan__glyph--done {
    color: var(--assistant-accent);
}

.chat-plan__glyph--failed {
    color: var(--error-accent);
}

.chat-plan__glyph--skipped {
    color: var(--muted-text);
}

.chat-plan__summary {
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.chat-plan__summary--inactive {
    color: var(--muted-text);
}

.chat-plan__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 2px;
}

/* Docked prompt bar (Sprint 25.7 follow-up): the active molca_ask_user question anchored above the
   composer with its option buttons, rather than buried inline in the transcript. */
.chat-prompt-bar {
    flex-shrink: 0;
    flex-direction: column;
    margin-bottom: 4px;
    padding: 6px 8px;
    background-color: var(--row-bg-prompt);
    border-left-width: 3px;
    border-left-color: var(--prompt-accent);
    border-radius: 4px;
}

/* Cap the question height so a long batch-confirmation prompt scrolls internally instead of
   pushing the options buttons and composer off-screen (the prompt bar is a sibling of the
   composer and does not scroll as a whole). */
.chat-prompt-bar__question-scroll {
    flex-shrink: 0;
    max-height: 180px;
    margin-bottom: 4px;
}

.chat-prompt-bar__question {
    white-space: normal;
    -unity-font-style: bold;
    color: var(--prompt-accent);
}

.chat-prompt-bar__options {
    flex-direction: row;
    flex-wrap: wrap;
}

.chat-row__spacer {
    flex-grow: 1;
}

.chat-live-text {
    white-space: normal;
    color: var(--muted-text);
    -unity-font-style: italic;
}

/* Per-role body text tints (assistant/user use the default label color). */
.chat-body--tool {
    color: var(--muted-text);
    font-size: 11px;
}

.chat-body--error {
    color: var(--error-accent);
}

/* ---- Buttons ------------------------------------------------------------------------------ */

.chat-mini-button {
    font-size: 10px;
    height: 16px;
    margin-left: 3px;
    padding-left: 5px;
    padding-right: 5px;
    flex-shrink: 0;
}

/* ---- Tool payloads -----------------------------------------------------------------------
 * Inline/block Markdown rendering moved to the shared molca-md-* classes (Sprint 88,
 * Editor/UI/Components/MolcaEditorComponents.uss); only the raw tool-payload style is chat-specific. */

.chat-raw-payload {
    white-space: normal;
    font-size: 11px;
    margin-top: 2px;
    padding: 4px 6px;
    background-color: var(--code-bg);
}

/* In-window provider + model picker (Sprint 71). */
.chat-model-picker {
    flex-direction: column;
    margin-bottom: 4px;
}

.chat-model-picker__controls {
    flex-direction: row;
    align-items: center;
}

.chat-model-picker__provider {
    margin-right: 4px;
    min-width: 120px;
}

.chat-model-picker__model {
    margin-right: 2px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.chat-model-picker__menu {
    width: 22px;
    margin-right: 2px;
}

.chat-model-picker__detect {
    margin-right: 6px;
}

.chat-model-picker__hint {
    color: var(--muted-text);
    -unity-font-style: italic;
    white-space: normal;
    min-width: 0;
    font-size: 11px;
    margin-top: 2px;
}

.chat-model-picker__hint--warn {
    color: var(--molca-status-warn);
    -unity-font-style: normal;
}

/* ---- Image attachments (Sprint 73) -------------------------------------------------------- */

.chat-attach-button {
    margin-left: 4px;
    padding: 1px 8px;
    font-size: 11px;
}

.chat-attach-thumbs {
    flex-direction: row;
    flex-wrap: wrap;
}

.chat-attach-thumb {
    flex-direction: row;
    align-items: center;
    margin: 2px 4px 2px 0;
    padding: 2px 4px;
    border-radius: 3px;
    background-color: var(--row-bg-user);
}

.chat-attach-thumb__image {
    width: 40px;
    height: 40px;
    margin-right: 4px;
    border-radius: 2px;
}

.chat-attach-thumb__label {
    font-size: 11px;
    color: var(--chip-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
}
