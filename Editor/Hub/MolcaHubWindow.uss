/*
 * Molca Hub shell styles (Sprint 26.1).
 * These classes intentionally mirror the design handoff vocabulary: workspace tabs, left rail,
 * section cards, compact field rows, links, mini buttons, and status dots.
 */

/*
 * Token definitions (--hub-* / --molca-*) live in Editor/UI/MolcaEditorTokens.uss and are applied
 * via MolcaEditorUi.Apply() (the root also carries the `molca-editor` class). This sheet only
 * consumes them through var(). See EDITOR_DESIGN_LANGUAGE.md.
 */
.molca-hub-root {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--hub-bg);
    color: var(--hub-text);
}

.molca-hub-workspace-toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--hub-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border);
}

/*
 * Workspace tab: an [icon] [label] row with a bottom accent underline. The underline is a dedicated
 * child element (.molca-hub-workspace-tab__underline), NOT a button border — Unity's built-in Button
 * repaints its own border box on :focus/:active, which erased a border-based underline the instant a
 * tab was clicked and took focus. A child element is immune to that. Tabs stretch full toolbar height
 * so the underline can sit flush on the header's bottom seam.
 */
.molca-hub-workspace-tab {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hub-muted);
    font-size: 12px;
    transition-property: color, background-color;
    transition-duration: 0.1s;
}

.molca-hub-workspace-tab:hover {
    color: var(--hub-heading);
    background-color: var(--hub-control);
}

/* No explicit color: `color` is an inherited USS property, so the label picks up the tab's muted /
   hover / active color automatically. (Setting `color: inherit` is invalid in Unity USS — it
   spams "read value of type Color while reading a value of type Keyword" and leaves the label
   unpainted.) */
.molca-hub-workspace-tab__label {
    font-size: 12px;
}

.molca-hub-workspace-tab__icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

/*
 * Bottom accent underline. Absolutely positioned along the tab's bottom edge (out of flow, so it
 * never shifts the icon/label row) and overlapping the toolbar's 1px bottom border. Transparent at
 * rest; a faint hint on hover; the full accent color when the tab is the active workspace.
 */
.molca-hub-workspace-tab__underline {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: -1px;
    height: 2px;
    border-radius: 1px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.molca-hub-workspace-tab:hover .molca-hub-workspace-tab__underline {
    background-color: var(--hub-border-soft);
}

/* Active tab: brighter label + a solid accent underline. Declared for the parent's active class so
   the descendant underline wins regardless of the button's own :hover/:focus/:active pseudo-state. */
.molca-hub-workspace-tab--active .molca-hub-workspace-tab__label {
    color: var(--hub-heading);
}

.molca-hub-workspace-tab--active .molca-hub-workspace-tab__underline {
    background-color: var(--hub-primary);
}

/* Thin vertical divider between adjacent tabs for clearer separation. */
.molca-hub-tab-divider {
    width: 1px;
    margin-top: 8px;
    margin-bottom: 8px;
    flex-shrink: 0;
    background-color: var(--hub-border-soft);
}

.molca-hub-spacer {
    flex-grow: 1;
}

.molca-hub-button {
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--hub-card);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 10px;
}

.molca-hub-body {
    flex-grow: 1;
    min-height: 0;
}

.molca-hub-workspace-host {
    flex-grow: 1;
    min-height: 0;
}

/* ---- Bottom activity rail ---- */

/*
 * Slim strip pinned below the body/host (last child of the flex-column root). Fixed height, never grows;
 * the view toggles its own display to None when no provider has anything to show.
 */
.molca-hub-activity-rail {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: var(--hub-card-header);
    border-top-width: 1px;
    border-top-color: var(--hub-border);
}

.molca-hub-activity-rail__chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

/* Developer-license pill, right-anchored to the far end of the rail (margin-left: auto). */
.molca-hub-activity-rail__license {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
    padding-left: 10px;
}

.molca-hub-activity-rail__license:hover .molca-hub-activity-rail__license-label {
    color: var(--hub-accent);
}

.molca-hub-activity-rail__license-label {
    color: var(--hub-muted);
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

/* Dedicated license status dot: base + color modifiers live in this one sheet so the color wins by
   source order (no cross-stylesheet specificity tie with the activity-chip dot's grey base). */
.molca-hub-activity-rail__license-dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--molca-status-grey);
}

.molca-hub-activity-rail__license-dot--ok {
    background-color: var(--molca-status-green);
}

.molca-hub-activity-rail__license-dot--warn {
    background-color: var(--molca-status-warn);
}

.molca-hub-activity-rail__license-dot--error {
    background-color: var(--molca-status-error);
}

.molca-hub-activity-rail__license-dot--idle {
    background-color: var(--molca-status-grey);
}

.molca-hub-activity-chip {
    /* position: relative so the absolute progress track anchors to the chip. */
    position: relative;
    flex-direction: row;
    align-items: center;
    height: 20px;
    max-width: 200px;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 6px;
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 3px;
    background-color: var(--hub-control);
    overflow: hidden;
}

.molca-hub-activity-chip__body {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.molca-hub-activity-chip__body--clickable:hover .molca-hub-activity-chip__label {
    color: var(--hub-accent);
}

.molca-hub-activity-chip__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--molca-status-grey);
}

/* Running: accent so the eye tracks the in-flight process. */
.molca-hub-activity-chip__dot--running {
    background-color: var(--hub-accent);
}

.molca-hub-activity-chip__label {
    color: var(--hub-text);
    font-size: 10px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

/* Status truncates with an ellipsis so a long check id / message never stretches the chip past its cap. */
.molca-hub-activity-chip__status {
    color: var(--hub-muted);
    font-size: 10px;
    margin-left: 6px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
}

.molca-hub-activity-chip__dismiss {
    margin-left: 6px;
    margin-right: 0;
    padding: 0;
    width: 15px;
    height: 15px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hub-muted);
    font-size: 10px;
    flex-shrink: 0;
}

.molca-hub-activity-chip__dismiss:hover {
    background-color: var(--hub-panel);
    color: var(--hub-text);
}

/* Determinate progress: a hairline track along the chip's bottom edge with an accent fill. */
.molca-hub-activity-chip__track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background-color: var(--hub-border);
}

.molca-hub-activity-chip__fill {
    height: 2px;
    background-color: var(--hub-accent);
}

.molca-hub-rail {
    background-color: var(--hub-panel);
    border-right-width: 1px;
    border-right-color: var(--hub-border);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 0;
    padding-right: 0;
}

.molca-hub-search {
    margin-left: 9px;
    margin-right: 9px;
    margin-bottom: 8px;
}

.molca-hub-search TextInput {
    -unity-text-align: middle-left;
    background-color: var(--hub-input);
    border-color: var(--hub-border);
    border-radius: 3px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.molca-hub-search-placeholder {
    position: absolute;
    left: 17px;
    top: 4px;
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-rail-list {
    flex-grow: 1;
}

.molca-hub-rail-item {
    min-height: 29px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hub-text);
    -unity-text-align: middle-left;
    font-size: 11px;
}

.molca-hub-rail-item--selected {
    background-color: var(--hub-row-selected);
    border-left-color: var(--hub-accent);
    color: var(--hub-on-row-selected);
}

.molca-hub-detail-scroll {
    flex-grow: 1;
    min-height: 0;
    background-color: var(--hub-bg);
}

.molca-hub-detail {
    padding: 14px;
}

.molca-hub-detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 13px;
}

.molca-hub-logo-tile {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--hub-border);
    background-color: var(--hub-input);
    align-items: center;
    justify-content: center;
    margin-right: 9px;
}

.molca-hub-logo-mark {
    color: var(--hub-accent);
    -unity-font-style: bold;
    font-size: 19px;
    -unity-text-align: middle-center;
}

.molca-hub-title-stack {
    flex-grow: 1;
}

.molca-hub-title {
    color: var(--hub-heading);
    font-size: 15px;
    -unity-font-style: bold;
}

.molca-hub-muted {
    color: var(--hub-muted);
    white-space: normal;
    font-size: 11px;
}

.molca-hub-detail-content {
    flex-grow: 1;
}

.molca-hub-project-section {
    flex-grow: 1;
}

.molca-hub-project-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.molca-hub-project-logo {
    width: 36px;
    height: 36px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--hub-border);
    background-color: var(--hub-input);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.molca-hub-project-logo__mark {
    color: var(--hub-accent);
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.molca-hub-project-logo__image {
    width: 24px;
    height: 24px;
}

.molca-hub-project-title-stack {
    flex-grow: 1;
}

.molca-hub-project-title {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 17px;
}

.molca-hub-project-subtitle {
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-section-card {
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    background-color: var(--hub-card);
    margin-bottom: 14px;
}

.molca-hub-section-card__header {
    min-height: 29px;
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--hub-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border-soft);
}

.molca-hub-section-card__title-stack {
    flex-grow: 1;
}

.molca-hub-section-card__title {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 12px;
}

.molca-hub-section-card__subtitle {
    color: var(--hub-muted);
    font-size: 10px;
    margin-top: 1px;
}

.molca-hub-section-card__status-label {
    color: var(--hub-muted);
    font-size: 10px;
    margin-left: 5px;
    margin-right: 6px;
}

.molca-hub-section-card__actions {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
}

.molca-hub-section-card__body {
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 12px;
    padding-right: 12px;
}

.molca-hub-section-card__body--disabled {
    opacity: 0.4;
}

.molca-hub-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--hub-status-grey);
}

.molca-hub-status-dot--ok {
    background-color: var(--hub-status-green);
}

.molca-hub-status-dot--idle {
    background-color: var(--hub-status-grey);
}

.molca-hub-status-dot--warn {
    background-color: var(--hub-status-warn);
}

.molca-hub-status-dot--error {
    background-color: var(--hub-status-error);
}

.molca-hub-help-button {
    width: 20px;
    height: 20px;
    padding: 0;
    border-radius: 10px;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.molca-hub-field-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 8px;
}

.molca-hub-field-row--top {
    align-items: flex-start;
}

.molca-hub-field-label {
    width: 160px;
    flex-shrink: 0;
    color: var(--hub-label);
    font-size: 11px;
}

.molca-hub-field-control {
    flex-grow: 1;
    min-width: 0;
}

.molca-hub-project-id-box {
    flex-grow: 1;
    min-height: 22px;
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 2px;
    padding-left: 7px;
    padding-right: 7px;
}

.molca-hub-project-id-text {
    flex-grow: 1;
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-logo-picker {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.molca-hub-logo-preview {
    width: 38px;
    height: 38px;
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 4px;
    background-color: var(--hub-input);
    align-items: center;
    justify-content: center;
    margin-right: 9px;
}

.molca-hub-logo-preview__mark {
    color: var(--hub-accent);
    -unity-font-style: bold;
    font-size: 22px;
    -unity-text-align: middle-center;
}

.molca-hub-logo-preview__image {
    width: 30px;
    height: 30px;
}

.molca-hub-logo-picker__stack {
    flex-grow: 1;
}

.molca-hub-logo-picker__name {
    color: var(--hub-text);
    font-size: 11px;
    margin-bottom: 3px;
}

.molca-hub-logo-picker__field {
    max-width: 240px;
}

.molca-hub-link {
    color: var(--hub-link);
}

.molca-hub-link-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
}

.molca-hub-link-button {
    flex-grow: 1;
    min-width: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hub-link);
    -unity-text-align: middle-left;
    font-size: 11px;
}

.molca-hub-divider {
    height: 1px;
    background-color: var(--hub-border-soft);
    margin-top: 7px;
    margin-bottom: 7px;
}

.molca-hub-mini-button {
    height: 20px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
    border-radius: 2px;
}

/* ----- Build & Version section (Sprint 26.6) ----- */

.molca-hub-buildversion-section {
    flex-grow: 1;
}

.molca-hub-bv-context {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
}

.molca-hub-bv-context__marker {
    width: 13px;
    height: 13px;
    border-radius: 2px;
    background-color: var(--hub-accent);
    margin-right: 8px;
}

.molca-hub-bv-context__asset {
    color: var(--hub-text);
    font-size: 11px;
}

.molca-hub-bv-context__sep {
    width: 1px;
    height: 14px;
    background-color: var(--hub-border-soft);
    margin-left: 10px;
    margin-right: 10px;
}

.molca-hub-bv-context__meta {
    color: var(--hub-muted);
    font-size: 11px;
    margin-right: 10px;
}

.molca-hub-bv-primary-pill {
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 2px;
    background-color: var(--hub-primary);
    color: white;
    font-size: 11px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 12px;
    padding-right: 12px;
}

.molca-hub-bv-segmented {
    flex-direction: row;
    margin-bottom: 12px;
}

.molca-hub-bv-segment {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 1px;
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 11px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.molca-hub-bv-segment--active {
    background-color: var(--hub-primary);
    color: white;
}

.molca-hub-bv-build-row {
    flex-direction: row;
    align-items: flex-start;
}

.molca-hub-bv-profile-rail {
    flex-shrink: 0;
    width: 182px;
    margin-right: 10px;
    background-color: var(--hub-panel);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
}

.molca-hub-bv-rail-header {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 8px;
    background-color: var(--hub-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border-soft);
}

.molca-hub-bv-rail-title {
    flex-grow: 1;
    color: var(--hub-muted);
    font-size: 10px;
    -unity-font-style: bold;
}

.molca-hub-bv-rail-actions {
    flex-direction: row;
}

.molca-hub-bv-rail-button {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding: 0;
    border-width: 1px;
    border-color: var(--hub-card);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.molca-hub-bv-profile-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 34px;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 8px;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.molca-hub-bv-profile-row--selected {
    background-color: var(--hub-row-selected);
    border-left-color: var(--hub-accent);
}

.molca-hub-bv-profile-row__stack {
    flex-grow: 1;
    min-width: 0;
}

.molca-hub-bv-profile-row__name {
    color: var(--hub-heading);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.molca-hub-bv-profile-row__target {
    color: var(--hub-muted);
    font-size: 9px;
    -unity-text-align: middle-left;
}

.molca-hub-bv-active-badge {
    color: var(--hub-accent);
    font-size: 9px;
    border-width: 1px;
    border-color: var(--hub-accent);
    border-radius: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.molca-hub-bv-profile-detail {
    flex-grow: 1;
    min-width: 0;
    background-color: var(--hub-panel);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
}

.molca-hub-bv-detail-header {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--hub-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border-soft);
}

.molca-hub-bv-detail-dot {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background-color: var(--hub-accent);
    margin-right: 8px;
}

.molca-hub-bv-detail-title {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 12px;
    margin-right: 8px;
}

.molca-hub-bv-detail-sub {
    color: var(--hub-muted);
    font-size: 10px;
}

.molca-hub-bv-detail-body {
    padding: 11px;
}

/* Detail field labels hold longer captions ("Package Name Override", signing env vars)
   than the 118px project-section default, so widen the label column to prevent clipping. */
.molca-hub-bv-field > .molca-hub-field-label {
    width: 150px;
    flex-shrink: 0;
}

.molca-hub-bv-card {
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    margin-top: 11px;
}

.molca-hub-bv-card__header {
    color: var(--hub-muted);
    font-size: 10px;
    -unity-font-style: bold;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 9px;
    padding-right: 9px;
    background-color: var(--hub-card);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border-soft);
}

.molca-hub-bv-card__body {
    padding: 9px;
}

.molca-hub-bv-options-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.molca-hub-bv-option-group {
    width: 50%;
    margin-bottom: 8px;
    padding-right: 10px;
}

.molca-hub-bv-option-heading {
    color: var(--hub-muted);
    font-size: 9px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.molca-hub-bv-toggle-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.molca-hub-bv-toggle-label {
    flex-grow: 1;
    color: var(--hub-label);
    font-size: 11px;
}

.molca-hub-bv-toggle {
    flex-shrink: 0;
}

.molca-hub-bv-signing {
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 8px;
    border-left-width: 2px;
    border-left-color: var(--hub-card-header);
}

.molca-hub-bv-actions {
    flex-direction: row;
    margin-top: 11px;
}

.molca-hub-bv-action {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 11px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.molca-hub-bv-action--primary {
    flex-grow: 1.4;
    background-color: var(--hub-primary);
    color: white;
}

/* Full-width standalone/stacked action button. Unlike .molca-hub-bv-action (which uses flex-grow to
   share width inside a horizontal .molca-hub-bv-actions row), this does not grow on the main axis, so
   it stays a normal-height full-width button when placed directly in a column card body. */
.molca-hub-action-full {
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 6px;
    margin-left: 0;
    margin-right: 0;
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 11px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.molca-hub-action-full--primary {
    background-color: var(--hub-primary);
    color: white;
}

.molca-hub-bv-summary {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 11px;
    padding-bottom: 11px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 12px;
}

.molca-hub-bv-summary__stack {
    margin-right: 16px;
}

.molca-hub-bv-summary__caption {
    color: var(--hub-muted);
    font-size: 10px;
}

.molca-hub-bv-summary__value {
    color: var(--hub-heading);
    font-size: 22px;
}

.molca-hub-bv-summary__meta {
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-bv-version-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.molca-hub-bv-version-field {
    width: 50%;
    margin-bottom: 6px;
    padding-right: 12px;
}

.molca-hub-bv-version-field__label {
    width: 50px;
}

.molca-hub-bv-warning {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding: 8px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.molca-hub-bv-warning__icon {
    color: var(--hub-status-warn);
    font-size: 13px;
    margin-right: 8px;
}

.molca-hub-bv-warning__text {
    flex-grow: 1;
    color: var(--hub-muted);
    font-size: 11px;
    white-space: normal;
}

.molca-hub-bv-foldout {
    margin-top: 4px;
}

.molca-hub-bv-history-entry {
    color: var(--hub-text);
    font-size: 11px;
    margin-top: 3px;
}

.molca-hub-bv-footer {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--hub-border-soft);
}

.molca-hub-bv-footer__button {
    margin-left: 0;
    margin-right: 0;
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 11px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.molca-hub-bv-footer__note {
    -unity-text-align: middle-center;
    color: var(--hub-muted);
    font-size: 10px;
    margin-top: 4px;
}

/* ----- Runtime & Global section (Sprint 26.7) ----- */

.molca-hub-runtime-section {
    flex-grow: 1;
}

.molca-hub-rt-context {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
}

.molca-hub-rt-context__crumb {
    flex-direction: row;
    align-items: center;
}

.molca-hub-rt-context__marker {
    width: 13px;
    height: 13px;
    border-radius: 2px;
    margin-right: 6px;
}

.molca-hub-rt-context__marker--runtime {
    background-color: var(--hub-primary);
}

.molca-hub-rt-context__marker--global {
    background-color: var(--hub-accent);
}

.molca-hub-rt-context__label {
    color: var(--hub-text);
    font-size: 11px;
}

.molca-hub-rt-context__sep {
    color: var(--hub-muted);
    font-size: 13px;
    margin-left: 8px;
    margin-right: 8px;
}

.molca-hub-rt-context__ping {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--hub-muted);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.molca-hub-rt-context__field {
    width: 170px;
    margin-left: 4px;
    margin-right: 0;
}

.molca-hub-rt-chip {
    border-width: 1px;
    border-color: var(--hub-card);
    border-radius: 2px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 9px;
    padding-right: 9px;
}

.molca-hub-rt-modules {
    flex-grow: 1;
}

.molca-hub-rt-modules-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 9px;
}

.molca-hub-rt-modules-title {
    color: var(--hub-muted);
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 7px;
}

.molca-hub-rt-modules-count {
    color: var(--hub-muted);
    font-size: 10px;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 9px;
    padding-left: 7px;
    padding-right: 7px;
}

/* Horizontal wrapping chip strip — replaces the vertical rail so the detail/inspector
   below gets the full panel width. */
.molca-hub-rt-chip-strip {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 14px;
}

.molca-hub-rt-chip-item {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 11px;
    padding-right: 11px;
    border-width: 1px;
    border-color: var(--hub-card);
    border-radius: 13px;
    background-color: var(--hub-input);
    color: var(--hub-text);
    font-size: 11px;
}

.molca-hub-rt-chip-item--selected {
    border-color: var(--hub-primary);
    background-color: var(--hub-primary);
    color: white;
}

.molca-hub-rt-chip-item__name {
    margin-left: 7px;
    color: var(--hub-text);
    font-size: 11px;
    white-space: nowrap;
}

.molca-hub-rt-chip-item--selected .molca-hub-rt-chip-item__name {
    color: white;
}

.molca-hub-rt-detail {
    background-color: var(--hub-panel);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
}

.molca-hub-rt-detail-header {
    flex-direction: row;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: var(--hub-card-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--hub-border-soft);
}

.molca-hub-rt-detail-title {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 12px;
    margin-left: 8px;
    margin-right: 8px;
}

.molca-hub-rt-detail-type {
    color: var(--hub-muted);
    font-size: 10px;
}

.molca-hub-rt-detail-body {
    padding: 12px;
}

.molca-hub-rt-inspector {
    flex-grow: 1;
}

/* ----- Editor & MCP sections (Sprint 26.8) ----- */

.molca-hub-editor-section {
    flex-grow: 1;
}

.molca-hub-mcp-section {
    flex-grow: 1;
}

.molca-hub-card-header-toggle {
    margin-left: 4px;
    margin-right: 2px;
}

.molca-hub-mcp-intro {
    color: var(--hub-muted);
    font-size: 11px;
    white-space: normal;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 2px;
    padding: 8px;
    margin-bottom: 12px;
}

.molca-hub-provider-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
}

.molca-hub-provider-row__stack {
    flex-grow: 1;
    min-width: 0;
    margin-left: 9px;
}

.molca-hub-provider-row__name {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-provider-row__status {
    color: var(--hub-muted);
    font-size: 10px;
    margin-top: 1px;
}

.molca-hub-provider-row__assign {
    width: 180px;
    margin-right: 6px;
}

.molca-hub-mcp-token-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.molca-hub-mcp-token {
    flex-grow: 1;
    min-width: 0;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 2px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 7px;
    padding-right: 7px;
    margin-right: 4px;
    color: var(--hub-text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-mcp-log {
    max-height: 120px;
    margin-top: 6px;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 2px;
}

.molca-hub-mcp-log__text {
    color: var(--hub-label);
    font-size: 10px;
    white-space: normal;
    padding: 6px;
}

.molca-hub-mcp-allowlist {
    margin-top: 6px;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border);
    border-radius: 2px;
    padding: 6px;
}

.molca-hub-mcp-allowlist--readonly {
    min-height: 115px;
}

.molca-hub-mcp-allowlist--action {
    min-height: 142px;
}

.molca-hub-mcp-allowlist__grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.molca-hub-mcp-allowlist__cell {
    width: 50%;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    padding-right: 10px;
}

.molca-hub-allow-name {
    flex-grow: 1;
    min-width: 0;
    color: var(--hub-text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-allow-badges {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 6px;
}

.molca-hub-allow-badge {
    font-size: 8px;
    -unity-font-style: bold;
    border-radius: 2px;
    border-width: 1px;
    padding-left: 4px;
    padding-right: 4px;
    margin-left: 3px;
    color: var(--hub-text);
    background-color: rgba(128, 128, 128, 0.18);
    border-color: rgba(128, 128, 128, 0.40);
}

.molca-hub-allow-badge--action {
    color: var(--hub-status-error);
    border-color: rgba(224, 112, 58, 0.45);
    background-color: rgba(224, 112, 58, 0.16);
}

.molca-hub-allow-badge--undo {
    color: var(--hub-status-green);
    border-color: rgba(87, 200, 74, 0.45);
    background-color: rgba(87, 200, 74, 0.15);
}

.molca-hub-allow-badge--play {
    color: var(--hub-link);
    border-color: rgba(91, 155, 213, 0.45);
    background-color: rgba(91, 155, 213, 0.15);
}

.molca-hub-allow-toggle {
    flex-shrink: 0;
}

.molca-hub-mcp-allowlist-nav {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.molca-hub-mcp-allowlist-nav__label {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: var(--hub-muted);
    font-size: 10px;
}

/* ----- Integrations section stub (Sprint 26.9) ----- */

.molca-hub-integrations-section {
    flex-grow: 1;
}

.molca-hub-integrations-title {
    color: var(--hub-heading);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.molca-hub-integrations-subtitle {
    color: var(--hub-muted);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 13px;
}

.molca-hub-integration-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 9px;
}

.molca-hub-integration-icon {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    margin-right: 10px;
    color: white;
    -unity-font-style: bold;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.molca-hub-integration-stack {
    flex-grow: 0;
}

.molca-hub-integration-name {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 12px;
}

.molca-hub-integration-desc {
    color: var(--hub-muted);
    font-size: 10px;
    margin-top: 1px;
}

.molca-hub-integration-status {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
}

.molca-hub-integration-status__label {
    color: var(--hub-muted);
    font-size: 10px;
    margin-left: 6px;
}

.molca-hub-integration-add {
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 9px;
    padding-bottom: 9px;
    color: var(--hub-muted);
    font-size: 11px;
    border-color: var(--hub-border-soft);
    -unity-text-align: middle-center;
}

/* ---- Tasks section (Sprint 31) ---- */

.molca-hub-tasks-section {
    flex-grow: 1;
}

.molca-hub-tasks-controls {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.molca-hub-tasks-controls Toggle {
    margin-right: 12px;
    font-size: 11px;
}

.molca-hub-tasks-list {
    flex-grow: 1;
}

.molca-hub-task-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-card);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
}

.molca-hub-task-name {
    color: var(--hub-heading);
    font-size: 12px;
    white-space: normal;
    flex-shrink: 1;
}

.molca-hub-task-name--link {
    color: var(--hub-link);
}

.molca-hub-task-list-badge {
    color: var(--hub-muted);
    font-size: 9px;
    margin-left: 8px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    background-color: var(--hub-card-header);
    border-radius: 3px;
}

.molca-hub-task-status {
    min-width: 130px;
    margin-left: 8px;
    font-size: 11px;
}

.molca-hub-task-status-static {
    color: var(--hub-muted);
    font-size: 11px;
    margin-left: 8px;
}

/* ----- Network telemetry section (Sprint 36.8) ----- */

.molca-hub-network-section {
    flex-grow: 1;
}

.molca-hub-network-metric {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
}

.molca-hub-network-metric__label {
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-network-metric__value {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 11px;
}

.molca-hub-network-row {
    flex-direction: row;
    align-items: center;
    background-color: var(--hub-input);
    border-width: 1px;
    border-color: var(--hub-border-soft);
    border-radius: 3px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 4px;
}

.molca-hub-network-row__url {
    flex-grow: 1;
    min-width: 0;
    margin-left: 8px;
    color: var(--hub-text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-network-row__status {
    color: var(--hub-muted);
    font-size: 11px;
    margin-left: 8px;
    min-width: 56px;
    -unity-text-align: middle-right;
}

.molca-hub-network-row__latency {
    color: var(--hub-muted);
    font-size: 11px;
    margin-left: 8px;
    min-width: 56px;
    -unity-text-align: middle-right;
}

/* ---- Docs section: reference-guide browser (renders via MolcaMarkdown) ---- */
.molca-hub-docs-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.molca-hub-docs-tab {
    margin-right: 4px;
    margin-bottom: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--hub-control);
    color: var(--hub-text);
    font-size: 11px;
}

.molca-hub-docs-tab--selected {
    background-color: var(--hub-primary);
    color: white;
}

.molca-hub-docs-content {
    margin-top: 8px;
}

.molca-hub-docs-body {
    padding-left: 2px;
    padding-right: 2px;
}

/* Product switcher above the docs navigation tree (shown only with >1 documentation set). */
.molca-hub-docs-product {
    margin-left: 9px;
    margin-right: 9px;
    margin-top: 2px;
    margin-bottom: 6px;
}

.molca-hub-docs-product .unity-base-field__label {
    display: none;
}

/* ---- Nested navigation rail (TreeView) ---- */
.molca-hub-rail-tree {
    flex-grow: 1;
}

.molca-hub-rail-node {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.molca-hub-rail-node__label {
    font-size: 12px;
    color: var(--hub-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-rail-node--category > .molca-hub-rail-node__label {
    -unity-font-style: bold;
    color: var(--hub-heading);
}

/* ---- About section ---- */

.molca-hub-about-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.molca-hub-about-logo {
    width: 36px;
    height: 36px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--hub-border);
    background-color: var(--hub-input);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.molca-hub-about-logo__image {
    width: 24px;
    height: 24px;
}

.molca-hub-about-logo__mark {
    color: var(--hub-accent);
    -unity-font-style: bold;
    font-size: 24px;
    -unity-text-align: middle-center;
}

.molca-hub-about-title-stack {
    flex-grow: 1;
}

.molca-hub-about-title {
    color: var(--hub-heading);
    -unity-font-style: bold;
    font-size: 17px;
}

.molca-hub-about-subtitle {
    color: var(--hub-muted);
    font-size: 11px;
}

.molca-hub-about-value {
    flex-grow: 1;
    min-width: 0;
    color: var(--hub-text);
    font-size: 11px;
    white-space: normal;
}

.molca-hub-about-section .molca-hub-field-label {
    width: 184px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-about-package-row > .molca-hub-field-label {
    width: 224px;
}

.molca-hub-about-link-row {
    min-width: 0;
    overflow: hidden;
}

.molca-hub-about-link {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: 0;
    min-width: 0;
    overflow: hidden;
}

.molca-hub-about-link > .molca-link-button {
    flex-shrink: 1;
    flex-basis: 0;
    width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.molca-hub-about-link > .molca-mini-button {
    flex-shrink: 0;
    margin-left: 8px;
}

.molca-hub-about-section--compact .molca-hub-field-row {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 12px;
}

.molca-hub-about-section--compact .molca-hub-field-row > .molca-hub-field-label {
    width: auto;
    margin-bottom: 3px;
}

.molca-hub-about-section--compact .molca-hub-about-value {
    padding-left: 8px;
}

.molca-hub-about-section--compact .molca-hub-about-link {
    padding-left: 2px;
}

.molca-hub-about-update-body {
    margin-top: 6px;
}

.molca-hub-about-release {
    margin-top: 6px;
    margin-bottom: 6px;
}

.molca-hub-about-highlight {
    color: var(--hub-text);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 2px;
}

.molca-hub-about-notes {
    color: var(--hub-muted);
    font-size: 11px;
    white-space: normal;
    margin-top: 6px;
    padding: 6px;
    border-left-width: 2px;
    border-left-color: var(--hub-border);
    background-color: var(--hub-input);
}

.molca-hub-about-eol {
    color: var(--hub-status-warn);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.molca-hub-about-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 4px;
}

.molca-hub-about-actions > .molca-button {
    margin-right: 6px;
}

.molca-hub-about-options {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--hub-border-soft);
}

.molca-hub-about-toggle {
    font-size: 11px;
}
